{
  "kind": "collectionType",
  "collectionName": "de_this",
  "info": {
    "singularName": "de-thi",
    "pluralName": "de-this",
    "displayName": "Đề thi",
    "description": "Đề thi (THPT QG, vào 10, giữa kì, cuối kì, ...)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "tieu_de": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "tieu_de",
      "required": true
    },
    "loai_de": {
      "type": "enumeration",
      "enum": [
        "tot-nghiep-thpt",
        "vao-10",
        "giua-ki-1",
        "cuoi-ki-1",
        "giua-ki-2",
        "cuoi-ki-2",
        "hoc-sinh-gioi",
        "minh-hoa",
        "thu",
        "dgnl"
      ],
      "required": true
    },
    "nam": {
      "type": "integer",
      "min": 2000,
      "max": 2050,
      "required": true
    },
    "lop": {
      "type": "integer",
      "min": 1,
      "max": 12,
      "required": true
    },
    "tinh_thanh": {
      "type": "string"
    },
    "noi_dung_de": {
      "type": "richtext"
    },
    "noi_dung_dap_an": {
      "type": "richtext"
    },
    "thoi_gian_lam_bai": {
      "type": "integer",
      "default": 90
    },
    "view_count": {
      "type": "integer",
      "default": 0
    },
    "meta_title": {
      "type": "string",
      "maxLength": 70
    },
    "meta_description": {
      "type": "text",
      "maxLength": 160
    },
    "file_de": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "file_dap_an": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "mon_hoc": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mon-hoc.mon-hoc"
    }
  }
}
