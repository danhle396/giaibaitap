# Copy file này thành .env.local và điền giá trị thực

NEXT_PUBLIC_SITE_URL=https://giaibaitap247.com

# Phase 1B — điền sau khi setup Strapi
# Local dev: http://localhost:1337  |  Prod: https://[strapi-app].railway.app
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# API token tạo trong Strapi admin: Settings → API Tokens → Create new
STRAPI_API_TOKEN=
# Secret tự sinh (random >= 32 ký tự), dùng verify webhook từ Strapi
REVALIDATE_SECRET=

# Analytics (Phase 1A.11)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# AdSense (sau khi được duyệt)
NEXT_PUBLIC_ADSENSE_ID=

# Phase 1B — Search
MEILISEARCH_URL=
MEILISEARCH_KEY=
